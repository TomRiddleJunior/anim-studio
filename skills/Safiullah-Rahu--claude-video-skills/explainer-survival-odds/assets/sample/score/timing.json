 "caps": [
  {
   "lid": "l01",
   "text": "If the zombie apocalypse",
   "col": "r",
   "t0": 0.18,
   "t1": 1.593,
   "on": 0.12,
   "off": 1.553
  },
  {
   "lid": "l01",
   "text": "catches you|on an oil rig",
   "col": "w",
   "t0": 1.593,
   "t1": 3.292,
   "on": 1.533,
   "off": 3.252
  },
  {
   "lid": "l01",
   "text": "in the middle|of the sea...",
   "col": "w",
   "t0": 3.292,
   "t1": 4.23,
   "on": 3.232,
   "off": 4.478
  },
  {
   "lid": "l01",
   "text": "consider yourself lucky.",
   "col": "g",
   "t0": 4.518,
   "t1": 6.205,
   "on": 4.458,
   "off": 6.775
  },
  {
   "lid": "l02",
   "text": "But only if you",
   "col": "w",
   "t0": 6.815,
   "t1": 7.54,
   "on": 6.755,
   "off": 7.5
  },
  {
   "lid": "l02",
   "text": "don't make one|fatal mistake.",
   "col": "r",
   "t0": 7.54,
   "t1": 9.59,
   "on": 7.48,
   "off": 10.29
  },
  {
   "lid": "l03",
   "text": "Meet Mira.",
   "col": "y",
   "t0": 10.35,
   "t1": 10.925,
   "on": 10.29,
   "off": 10.96
  },
  {
   "lid": "l03",
   "text": "She's thirty-three.",
   "col": "y",
   "t0": 11.0,
   "t1": 12.2,
   "on": 10.94,
   "off": 12.323
  },
  {
   "lid": "l03",
   "text": "She keeps a small|gas platform running,",
   "col": "w",
   "t0": 12.363,
   "t1": 14.525,
   "on": 12.303,
   "off": 14.56
  },
  {
   "lid": "l03",
   "text": "a hundred and forty|kilometres out at sea.",
   "col": "y",
   "t0": 14.6,
   "t1": 17.175,
   "on": 14.54,
   "off": 17.645
  },
  {
   "lid": "l04",
   "text": "Most nights,",
   "col": "w",
   "t0": 17.685,
   "t1": 18.21,
   "on": 17.625,
   "off": 18.22
  },
  {
   "lid": "l04",
   "text": "nobody lives here at all.",
   "col": "w",
   "t0": 18.26,
   "t1": 19.635,
   "on": 18.2,
   "off": 19.733
  },
  {
   "lid": "l04",
   "text": "Tonight,",
   "col": "w",
   "t0": 19.773,
   "t1": 20.185,
   "on": 19.713,
   "off": 20.195
  },
  {
   "lid": "l04",
   "text": "it's just Mira|and the seagulls.",
   "col": "w",
   "t0": 20.235,
   "t1": 22.36,
   "on": 20.175,
   "off": 22.83
  },
  {
   "lid": "l05",
   "text": "Check the pressures.",
   "col": "w",
   "t0": 22.87,
   "t1": 23.745,
   "on": 22.81,
   "off": 23.793
  },
  {
   "lid": "l05",
   "text": "Log the weather.",
   "col": "w",
   "t0": 23.833,
   "t1": 24.645,
   "on": 23.773,
   "off": 24.718
  },
  {
   "lid": "l05",
   "text": "Dinner for one.",
   "col": "w",
   "t0": 24.758,
   "t1": 25.92,
   "on": 24.698,
   "off": 26.44
  },
  {
   "lid": "l06",
   "text": "But tonight,",
   "col": "w",
   "t0": 26.48,
   "t1": 27.005,
   "on": 26.42,
   "off": 27.003
  },
  {
   "lid": "l06",
   "text": "her life changed forever.",
   "col": "r",
   "t0": 27.043,
   "t1": 28.83,
   "on": 26.983,
   "off": 29.4
  },
  {
   "lid": "l07",
   "text": "At nine forty,",
   "col": "y",
   "t0": 29.44,
   "t1": 30.165,
   "on": 29.38,
   "off": 30.163
  },
  {
   "lid": "l07",
   "text": "the radio crackled.",
   "col": "w",
   "t0": 30.203,
   "t1": 31.215,
   "on": 30.143,
   "off": 31.25
  },
  {
   "lid": "l07",
   "text": "The shore base.",
   "col": "w",
   "t0": 31.29,
   "t1": 32.14,
   "on": 31.23,
   "off": 32.213
  },
  {
   "lid": "l07",
   "text": "Outbreak in Port Ness.",
   "col": "r",
   "t0": 32.253,
   "t1": 33.715,
   "on": 32.193,
   "off": 33.813
  },
  {
   "lid": "l07",
   "text": "All flights stop|at midnight.",
   "col": "r",
   "t0": 33.853,
   "t1": 35.69,
   "on": 33.793,
   "off": 36.16
  },
  {
   "lid": "l08",
   "text": "Then the helicopter called.",
   "col": "w",
   "t0": 36.2,
   "t1": 37.525,
   "on": 36.14,
   "off": 37.572
  },
  {
   "lid": "l08",
   "text": "One seat left.",
   "col": "y",
   "t0": 37.612,
   "t1": 38.55,
   "on": 37.552,
   "off": 38.622
  },
  {
   "lid": "l08",
   "text": "Ten minutes.",
   "col": "y",
   "t0": 38.662,
   "t1": 39.75,
   "on": 38.602,
   "off": 40.27
  },
  {
   "lid": "l09",
   "text": "Mira looked|at the helideck...",
   "col": "w",
   "t0": 40.31,
   "t1": 41.61,
   "on": 40.25,
   "off": 41.645
  },
  {
   "lid": "l09",
   "text": "and said no.",
   "col": "g",
   "t0": 41.685,
   "t1": 42.81,
   "on": 41.625,
   "off": 43.33
  },
  {
   "lid": "l10",
   "text": "What if the pilot|was bitten?",
   "col": "r",
   "t0": 43.37,
   "t1": 44.895,
   "on": 43.31,
   "off": 44.955
  },
  {
   "lid": "l10",
   "text": "What if the heliport|was already gone?",
   "col": "r",
   "t0": 44.995,
   "t1": 47.17,
   "on": 44.935,
   "off": 47.267
  },
  {
   "lid": "l10",
   "text": "A helicopter is just",
   "col": "w",
   "t0": 47.307,
   "t1": 48.508,
   "on": 47.247,
   "off": 48.468
  },
  {
   "lid": "l10",
   "text": "a very fast way",
   "col": "w",
   "t0": 48.508,
   "t1": 49.57,
   "on": 48.448,
   "off": 49.53
  },
  {
   "lid": "l10",
   "text": "to land in|the middle of it.",
   "col": "r",
   "t0": 49.57,
   "t1": 51.12,
   "on": 49.51,
   "off": 51.64
  },
  {
   "lid": "l11",
   "text": "So Mira decided to stay.",
   "col": "g",
   "t0": 51.68,
   "t1": 53.155,
   "on": 51.62,
   "off": 53.24
  },
  {
   "lid": "l11",
   "text": "The dead can't swim.",
   "col": "g",
   "t0": 53.28,
   "t1": 54.355,
   "on": 53.22,
   "off": 54.365
  },
  {
   "lid": "l11",
   "text": "They sink.",
   "col": "g",
   "t0": 54.405,
   "t1": 55.33,
   "on": 54.345,
   "off": 55.8
  },
  {
   "lid": "l12",
   "text": "A hundred and forty|kilometres",
   "col": "y",
   "t0": 55.84,
   "t1": 57.502,
   "on": 55.78,
   "off": 57.462
  },
  {
   "lid": "l12",
   "text": "of cold, black water.",
   "col": "w",
   "t0": 57.502,
   "t1": 59.115,
   "on": 57.442,
   "off": 59.212
  },
  {
   "lid": "l12",
   "text": "Better than any wall.",
   "col": "g",
   "t0": 59.252,
   "t1": 60.665,
   "on": 59.192,
   "off": 61.135
  },
  {
   "lid": "l13",
   "text": "Emergency food",
   "col": "w",
   "t0": 61.175,
   "t1": 62.2,
   "on": 61.115,
   "off": 62.16
  },
  {
   "lid": "l13",
   "text": "for twelve people|for a month.",
   "col": "y",
   "t0": 62.2,
   "t1": 63.9,
   "on": 62.14,
   "off": 63.985
  },
  {
   "lid": "l13",
   "text": "For one person,",
   "col": "w",
   "t0": 64.025,
   "t1": 64.85,
   "on": 63.965,
   "off": 64.86
  },
  {
   "lid": "l13",
   "text": "that's almost a year.",
   "col": "g",
   "t0": 64.9,
   "t1": 66.45,
   "on": 64.84,
   "off": 66.92
  },
  {
   "lid": "l14",
   "text": "A machine that turns",
   "col": "w",
   "t0": 66.96,
   "t1": 67.922,
   "on": 66.9,
   "off": 67.882
  },
  {
   "lid": "l14",
   "text": "seawater into|drinking water.",
   "col": "w",
   "t0": 67.922,
   "t1": 69.71,
   "on": 67.862,
   "off": 69.795
  },
  {
   "lid": "l14",
   "text": "And power?",
   "col": "w",
   "t0": 69.835,
   "t1": 70.51,
   "on": 69.775,
   "off": 70.545
  },
  {
   "lid": "l14",
   "text": "The platform burns|its own gas.",
   "col": "w",
   "t0": 70.585,
   "t1": 72.51,
   "on": 70.525,
   "off": 72.582
  },
  {
   "lid": "l14",
   "text": "Forever.",
   "col": "g",
   "t0": 72.622,
   "t1": 73.51,
   "on": 72.562,
   "off": 73.98
  },
  {
   "lid": "l15",
   "text": "She pulled up|the boat ladder.",
   "col": "w",
   "t0": 74.02,
   "t1": 75.52,
   "on": 73.96,
   "off": 75.617
  },
  {
   "lid": "l15",
   "text": "She chained the gate|to the helideck.",
   "col": "w",
   "t0": 75.657,
   "t1": 77.645,
   "on": 75.597,
   "off": 78.165
  },
  {
   "lid": "l16",
   "text": "Food? Check.",
   "col": "g",
   "t0": 78.205,
   "t1": 78.73,
   "on": 78.145,
   "off": 78.74
  },
  {
   "lid": "l16",
   "text": "Water? Check.",
   "col": "g",
   "t0": 78.78,
   "t1": 79.405,
   "on": 78.72,
   "off": 79.415
  },
  {
   "lid": "l16",
   "text": "Power? Check.",
   "col": "g",
   "t0": 79.455,
   "t1": 80.555,
   "on": 79.395,
   "off": 81.175
  },
  {
   "lid": "l17",
   "text": "Ninety-seven percent.",
   "col": "y",
   "t0": 81.215,
   "t1": 82.44,
   "on": 81.155,
   "off": 82.475
  },
  {
   "lid": "l17",
   "text": "On paper...",
   "col": "w",
   "t0": 82.515,
   "t1": 83.565,
   "on": 82.455,
   "off": 84.265
  },
  {
   "lid": "l18",
   "text": "But Mira forgot one thing...",
   "col": "r",
   "t0": 84.375,
   "t1": 86.45,
   "on": 84.315,
   "off": 86.8
  }
 ],
