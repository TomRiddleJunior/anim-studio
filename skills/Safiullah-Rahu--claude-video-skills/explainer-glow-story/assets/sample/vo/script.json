{
 "voice": "af_heart",
 "speed": 0.96,
 "lead": 0.1,
 "tail": 2.4,
 "gap": 0.28,
 "lines": [
  {
   "id": "l01",
   "text": "I erase people's voices for a living."
  },
  {
   "id": "l02",
   "gap": 0.3,
   "text": "Voicemail, I mean."
  },
  {
   "id": "l03",
   "text": "When a mailbox fills up, I wipe it."
  },
  {
   "id": "l04",
   "text": "Three hundred a day."
  },
  {
   "id": "l05",
   "text": "We're never allowed to listen."
  },
  {
   "id": "l06",
   "gap": 0.45,
   "text": "Last winter, one box wouldn't stop filling."
  },
  {
   "id": "l07",
   "text": "Four hundred and twelve messages."
  },
  {
   "id": "l08",
   "text": "None of them heard."
  },
  {
   "id": "l09",
   "gap": 0.45,
   "text": "All from one number."
  },
  {
   "id": "l10",
   "text": "Every Sunday. Six p.m."
  },
  {
   "id": "l11",
   "text": "Four hundred and twelve Sundays."
  },
  {
   "id": "l13",
   "gap": 0.4,
   "text": "The box belonged to a woman named June."
  },
  {
   "id": "l14",
   "text": "June died eight years ago."
  },
  {
   "id": "l15",
   "text": "Someone still paid her bill."
  },
  {
   "id": "l16",
   "gap": 0.35,
   "text": "Every message was nine seconds long."
  },
  {
   "id": "l17",
   "text": "Nobody says much in nine seconds."
  },
  {
   "id": "l18",
   "gap": 0.4,
   "text": "I was supposed to wipe it."
  },
  {
   "id": "l19",
   "text": "A wipe erases her greeting, too."
  },
  {
   "id": "l20",
   "gap": 0.5,
   "text": "So I did something I'm not allowed to do."
  },
  {
   "id": "l21",
   "gap": 0.35,
   "text": "I pressed play."
  },
  {
   "id": "m1",
   "who": "him",
   "gap": 1.05,
   "voice": "bm_george",
   "speed": 0.84,
   "text": "Hi, June. Just wanted to hear you."
  },
  {
   "id": "l22",
   "gap": 0.6,
   "text": "He wasn't calling to say anything."
  },
  {
   "id": "l23",
   "text": "He was calling to hear this."
  },
  {
   "id": "g1",
   "who": "june",
   "gap": 0.6,
   "voice": "bf_emma",
   "speed": 0.9,
   "text": "Hi, it's June. Leave me something nice."
  },
  {
   "id": "l24",
   "gap": 0.7,
   "text": "Every Sunday, he did."
  },
  {
   "id": "l25",
   "gap": 0.5,
   "text": "Wipe it, and next Sunday he gets a stranger."
  },
  {
   "id": "l26",
   "gap": 0.55,
   "text": "You probably know a number like that."
  },
  {
   "id": "l27",
   "text": "One you'd call just to hear hello."
  },
  {
   "id": "l28",
   "gap": 0.6,
   "text": "So I cleared his messages."
  },
  {
   "id": "l29",
   "gap": 0.45,
   "text": "And I kept her voice."
  },
  {
   "id": "g2",
   "who": "june",
   "gap": 2.0,
   "voice": "bf_emma",
   "speed": 0.9,
   "text": "Hi, it's June. Leave me something nice."
  },
