[
{
"t0": 0.08,
"t1": 0.955,
"text": "Alaska and Alberta"
},
{
"t0": 0.955,
"t1": 1.555,
"text": "both struck it"
},
{
"t0": 1.555,
"t1": 3.24,
"text": "rich selling oil."
},
{
"t0": 3.24,
"t1": 4.302,
"text": "Alaska turned it into an"
},
{
"t0": 4.302,
"t1": 7.05,
"text": "eighty-eight-billion-dollar fund."
},
{
"t0": 7.05,
"t1": 7.988,
"text": "Alberta's fund is"
},
{
"t0": 7.988,
"t1": 8.613,
"text": "about a quarter"
},
{
"t0": 8.613,
"t1": 9.795,
"text": "of that."
},
{
"t0": 11.22,
"t1": 12.52,
"text": "In nineteen seventy-six,"
},
{
"t0": 12.52,
"t1": 13.495,
"text": "Alaskans voted to"
},
{
"t0": 13.495,
"t1": 14.082,
"text": "save part of"
},
{
"t0": 14.082,
"t1": 15.655,
"text": "their oil money."
},
{
"t0": 15.655,
"t1": 16.005,
"text": "At least"
},
{
"t0": 16.005,
"t1": 16.842,
"text": "twenty-five percent"
},
{
"t0": 16.842,
"t1": 17.63,
"text": "of oil royalties"
},
{
"t0": 17.63,
"t1": 18.865,
"text": "goes in,"
},
{
"t0": 18.865,
"t1": 19.94,
"text": "to one giant fund,"
},
{
"t0": 19.94,
"t1": 20.64,
"text": "and those savings"
},
{
"t0": 20.64,
"t1": 22.675,
"text": "can only be invested."
},
{
"t0": 22.675,
"t1": 23.462,
"text": "They invested it,"
},
{
"t0": 23.462,
"t1": 24.1,
"text": "and it just kept"
},
{
"t0": 24.1,
"t1": 25.51,
"text": "growing."
},
{
"t0": 25.51,
"t1": 26.147,
"text": "Now it pays out"
},
{
"t0": 26.147,
"t1": 27.135,
"text": "about three point eight"
},
{
"t0": 27.135,
"t1": 28.285,
"text": "billion dollars a year,"
},
{
"t0": 28.285,
"t1": 28.935,
"text": "for dividends"
},
{
"t0": 28.935,
"t1": 30.795,
"text": "and public services,"
},
{
"t0": 30.795,
"t1": 31.232,
"text": "and the fund"
},
{
"t0": 31.232,
"t1": 33.005,
"text": "is still growing."
},
{
"t0": 33.005,
"t1": 33.667,
"text": "Alberta went the"
},
{
"t0": 33.667,
"t1": 35.265,
"text": "other way."
},
{
"t0": 35.265,
"t1": 35.94,
"text": "It took in about"
},
{
"t0": 35.94,
"t1": 37.077,
"text": "eighteen billion dollars"
},
{
"t0": 37.077,
"t1": 37.99,
"text": "of resource revenue"
},
{
"t0": 37.99,
"t1": 39.65,
"text": "last year alone."
},
{
"t0": 39.65,
"t1": 40.312,
"text": "The plan back"
},
{
"t0": 40.312,
"t1": 42.235,
"text": "in nineteen seventy-six?"
},
{
"t0": 42.235,
"t1": 43.222,
"text": "To save thirty cents"
},
{
"t0": 43.222,
"t1": 45.68,
"text": "of every resource dollar."
},
{
"t0": 47.68,
"t1": 48.742,
"text": "In nineteen eighty-seven,"
},
{
"t0": 48.742,
"t1": 50.34,
"text": "the deposits stopped."
},
{
"t0": 50.34,
"t1": 51.24,
"text": "Not one new dollar"
},
{
"t0": 51.24,
"t1": 51.84,
"text": "went in until"
},
{
"t0": 51.84,
"t1": 53.625,
"text": "two thousand six."
},
{
"t0": 53.625,
"t1": 55.01,
"text": "Two places."
},
{
"t0": 55.01,
"t1": 56.52,
"text": "Same oil."
},
{
"t0": 56.52,
"t1": 58.455,
"text": "Alaska kept saving."
},
{
"t0": 58.455,
"t1": 59.105,
"text": "Alberta stopped"
},
{
